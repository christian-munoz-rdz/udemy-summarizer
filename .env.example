# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# .env no se sube al repositorio. Las variables del entorno del sistema
# tienen prioridad sobre este archivo. --token en la CLI pisa ambos.

# Cookie access_token de udemy.com (DevTools → Application → Cookies)
UDEMY_ACCESS_TOKEN=

# Cookie CAUTH de coursera.org (DevTools → Application → Cookies)
COURSERA_CAUTH=

# Clave de https://platform.claude.com/ (opcional; sin ella no hay resúmenes IA)
ANTHROPIC_API_KEY=
